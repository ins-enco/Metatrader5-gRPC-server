<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net472</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <AssemblyName>MetaTrader.Grpc.Client</AssemblyName>
    <RootNamespace>MetaTrader.Grpc.Client</RootNamespace>
    <PackageId>MetaTrader.Grpc.Client</PackageId>
    <Version>5.0.2</Version>
    <Authors>MetaTrader gRPC</Authors>
    <Company>MetaTrader gRPC</Company>
    <Description>C# client library for the MetaTrader 5 gRPC server contracts.</Description>
    <PackageTags>metatrader;mt5;grpc;protobuf;client</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <ProtoContractIdentity>protos-005-trade-transaction-events</ProtoContractIdentity>
    <TestedServerVersionRange>[0.3.0,1.0.0)</TestedServerVersionRange>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>5.0.2: adds OpenOrderAsync, ticket-only ClosePositionAsync, ticket-only CloseOrderAsync for pending-order cancellation, ModifyTradeAsync, ClosePositionByAsync, and deterministic ClosePositionsByAsync lifecycle helpers with separate call/execution status and no implicit retry. Position close derives request fields through one position and one symbol-info lookup; order close maps REMOVE without lookup. This is a C# client-only additive release: SendOrderAsync, proto/generated bindings, server behavior, target frameworks, and dependency groups are unchanged. Proto contract identity: protos-005-trade-transaction-events. Tested server range: [0.3.0,1.0.0).</PackageReleaseNotes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.29.3" />
    <PackageReference Include="Grpc.Core.Api" Version="2.71.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.71.0" />
    <PackageReference Include="Grpc.Tools" Version="2.71.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
  </ItemGroup>

  <!-- The .NET Framework target carries the legacy Grpc.Core native channel so
       consumers on Windows 10 / .NET Framework can use
       Mt5GrpcClientFactory.CreateCore(). net472 assets are consumed by net472,
       net48 and net481 alike, so a single FW target covers them all. Modern
       (netstandard2.0) consumers never pull in the deprecated native lib. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="Grpc.Core" Version="2.46.6" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\..\..\protos\*.proto" GrpcServices="Client" ProtoRoot="..\..\..\protos" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>MetaTrader.Grpc.Client.ContractTests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>MetaTrader.Grpc.Client.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
