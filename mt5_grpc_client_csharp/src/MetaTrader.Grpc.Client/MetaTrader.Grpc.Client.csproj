<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net472</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <AssemblyName>MetaTrader.Grpc.Client</AssemblyName>
    <RootNamespace>MetaTrader.Grpc.Client</RootNamespace>
    <PackageId>MetaTrader.Grpc.Client</PackageId>
    <Version>4.0.0</Version>
    <Authors>MetaTrader gRPC</Authors>
    <Company>MetaTrader gRPC</Company>
    <Description>C# client library for the MetaTrader 5 gRPC server contracts.</Description>
    <PackageTags>metatrader;mt5;grpc;protobuf;client</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <ProtoContractIdentity>protos-005-trade-transaction-events</ProtoContractIdentity>
    <TestedServerVersionRange>[0.3.0,1.0.0)</TestedServerVersionRange>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>4.0.0: adds a .NET Framework (net472) target that carries the legacy Grpc.Core native channel, enabling gRPC on .NET Framework 4.7.2+/Windows 10 where GrpcChannel + WinHttpHandler fails ("HTTP/2 features required by gRPC" not supported). New API: Mt5GrpcClientFactory.CreateCore / CreateCoreChannel (net472+ only). Mt5GrpcClient now accepts ChannelBase so the same typed client works with either GrpcChannel or Grpc.Core.Channel. Modern (netstandard2.0/.NET) consumers are unaffected and do not pull in the native lib. Proto contract identity: protos-005-trade-transaction-events. Tested server range: [0.3.0,1.0.0).</PackageReleaseNotes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.29.3" />
    <PackageReference Include="Grpc.Core.Api" Version="2.71.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.71.0" />
    <PackageReference Include="Grpc.Tools" Version="2.71.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
  </ItemGroup>

  <!-- The .NET Framework target carries the legacy Grpc.Core native channel so
       consumers on Windows 10 / .NET Framework can use
       Mt5GrpcClientFactory.CreateCore(). net472 assets are consumed by net472,
       net48 and net481 alike, so a single FW target covers them all. Modern
       (netstandard2.0) consumers never pull in the deprecated native lib. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="Grpc.Core" Version="2.46.6" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\..\..\protos\*.proto" GrpcServices="Client" ProtoRoot="..\..\..\protos" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>MetaTrader.Grpc.Client.ContractTests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
