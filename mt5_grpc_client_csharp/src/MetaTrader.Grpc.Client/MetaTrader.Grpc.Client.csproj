<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>MetaTrader.Grpc.Client</AssemblyName>
    <RootNamespace>MetaTrader.Grpc.Client</RootNamespace>
    <PackageId>MetaTrader.Grpc.Client</PackageId>
    <Version>2.0.2</Version>
    <Authors>MetaTrader gRPC</Authors>
    <Company>MetaTrader gRPC</Company>
    <Description>C# client library for the MetaTrader 5 gRPC server contracts.</Description>
    <PackageTags>metatrader;mt5;grpc;protobuf;client</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <ProtoContractIdentity>protos-005-trade-transaction-events</ProtoContractIdentity>
    <TestedServerVersionRange>[0.3.0,1.0.0)</TestedServerVersionRange>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>0.3.0 (additive, backward-compatible): adds TradeEventsService.SubscribeTradeTransactions, the first server-streaming RPC, exposed as IAsyncEnumerable&lt;TradeTransactionEvent&gt; plus a C# event wrapper (TradeTransactionSubscription). No existing RPC, message, field, or field number changed. Proto contract identity: protos-005-trade-transaction-events. Tested server range: [0.3.0,1.0.0).</PackageReleaseNotes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.29.3" />
    <PackageReference Include="Grpc.Core.Api" Version="2.71.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.71.0" />
    <PackageReference Include="Grpc.Tools" Version="2.71.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\..\..\protos\*.proto" GrpcServices="Client" ProtoRoot="..\..\..\protos" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>MetaTrader.Grpc.Client.ContractTests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
