<?xml version="1.0" encoding="utf-8"?>
<!--
  Sample consumer feed configuration for MetaTrader.Grpc.Client (Contract B).

  Copy this file next to your solution/project and set two environment variables
  before restoring:

      GITHUB_ACTOR          = your GitHub username
      GITHUB_PACKAGES_TOKEN = a GitHub PAT with at least the read:packages scope

  No token is committed - the credentials are read from the environment at restore
  time. Owner is the GitHub organization hosting this repository (ins-enco); the
  source key must be a valid XML element name.

  nuget.org is included so the client's runtime dependencies (Google.Protobuf,
  Grpc.*, Microsoft.Extensions.Logging.Abstractions) resolve automatically.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="github-ins-enco" value="https://nuget.pkg.github.com/ins-enco/index.json" />
  </packageSources>
  <packageSourceCredentials>
    <github-ins-enco>
      <add key="Username" value="%GITHUB_ACTOR%" />
      <add key="ClearTextPassword" value="%GITHUB_PACKAGES_TOKEN%" />
    </github-ins-enco>
  </packageSourceCredentials>
</configuration>
